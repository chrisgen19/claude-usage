#!/usr/bin/env bash
# claude-usage - the 5-hour and 7-day limits of every Claude Code profile, and
# every Codex one, on one screen, without opening a session in each.
#
# A profile is a CLAUDE_CONFIG_DIR. Its login is read from .credentials.json
# there (the Keychain on macOS) and handed to the usage endpoint behind /usage.
# A Codex profile is a CODEX_HOME: its login is auth.json, handed to the
# endpoint Codex asks for its own limits, and its session logs stand in when
# that cannot be read. A login is only ever read: refreshing one rotates the
# token and can sign out a session running in that profile, so an expired
# login is reported, never renewed.
#
# Dependencies: bash 4.2+, curl 7.55+ (for -H @-), jq.

set -uo pipefail
VERSION=0.1.0
PROG=${0##*/}

if [ "${BASH_VERSINFO[0]:-0}" -lt 4 ] ||
   { [ "${BASH_VERSINFO[0]}" -eq 4 ] && [ "${BASH_VERSINFO[1]}" -lt 2 ]; }; then
  printf '%s: needs bash 4.2 or newer, this is %s\n' "$PROG" "${BASH_VERSION:-?}" >&2
  printf '  on macOS: brew install bash\n' >&2
  exit 2
fi

API_URL=https://api.anthropic.com/api/oauth/usage
API_BETA=oauth-2025-04-20
# What Codex's own client asks for a ChatGPT login's limits. Not a public API
# either, and it wants the workspace the login belongs to beside the token.
CODEX_URL=https://chatgpt.com/backend-api/wham/usage
# The endpoint allows about one read a minute per account, and answers a
# second one with a 429. Any claude-usage on this machine reuses a reading
# younger than READ_GAP instead of asking again, and after a 429 that account
# waits BACKOFF_FIRST, doubling up to BACKOFF_MAX.
READ_GAP=60
DEF_INTERVAL=60
MIN_INTERVAL=$READ_GAP
BACKOFF_FIRST=120
BACKOFF_MAX=300
SPAN_5H=18000
SPAN_7D=604800
CACHE_DIR=${XDG_CACHE_HOME:-$HOME/.cache}/claude-usage
case $(uname -s) in Darwin) PLATFORM=darwin ;; *) PLATFORM=linux ;; esac

# ---------------------------------------------------------------- colour ----
UI_COLOR=0; UI_UNICODE=0
BLK=(); BAR_EMPTY="."; MARK="|"

palette() {
  if [ "$UI_COLOR" = 1 ]; then
    C_DIM=$'\033[2m'; C_B=$'\033[1m';  C_R=$'\033[31m'; C_Y=$'\033[33m'
    C_G=$'\033[32m';  C_C=$'\033[36m'; C_M=$'\033[35m'; C_BL=$'\033[34m'
    C_0=$'\033[0m'
  else
    C_DIM=""; C_B=""; C_R=""; C_Y=""; C_G=""; C_C=""; C_M=""; C_BL=""; C_0=""
  fi
  if [ "$UI_UNICODE" = 1 ]; then
    BLK=("▏" "▎" "▍" "▌" "▋" "▊" "▉" "█"); BAR_EMPTY="░"; MARK="│"
  else
    BLK=("#" "#" "#" "#" "#" "#" "#" "#"); BAR_EMPTY="."; MARK="|"
  fi
}

# Colour and glyphs are separate choices. NO_COLOR asks for no colour
# (no-color.org) and says nothing about block characters, which only need a
# terminal and a UTF-8 locale.
ui_detect() {
  UI_COLOR=0; UI_UNICODE=0
  if [ -t 1 ] && [ "${TERM:-dumb}" != dumb ]; then
    [ -z "${NO_COLOR:-}" ] && UI_COLOR=1
    case "${LC_ALL:-${LC_CTYPE:-${LANG:-}}}" in
      *UTF-8*|*utf-8*|*utf8*|*UTF8*) UI_UNICODE=1 ;;
    esac
  fi
  [ -z "${CLAUDE_USAGE_ASCII:-}" ] || UI_UNICODE=0
  palette
}
ui_detect

die() { printf '%s%s: %s%s\n' "$C_R" "$PROG" "$*" "$C_0" >&2; exit 2; }

need() {
  local t
  for t in curl jq; do
    command -v "$t" > /dev/null || die "$t not found - install it and try again"
  done
}

# ------------------------------------------------------------------ time ----
# Everything here is bash's own strftime, so GNU and BSD date never disagree.
NOW=0
tick() { printf -v NOW '%(%s)T' -1; }

# _left <seconds> - 6d11h, 1h53m, 42m, <1m
_left() {
  local s=$1
  if   [ "$s" -ge 86400 ]; then printf -v REPLY '%dd%dh' $(( s / 86400 )) $(( s % 86400 / 3600 ))
  elif [ "$s" -ge 3600 ];  then printf -v REPLY '%dh%02dm' $(( s / 3600 )) $(( s % 3600 / 60 ))
  elif [ "$s" -ge 60 ];    then printf -v REPLY '%dm' $(( s / 60 ))
  else REPLY="<1m"
  fi
}

# _ago <seconds> - just now, 5m ago, 3h ago, 2d ago
_ago() {
  local s=$1
  if   [ "$s" -lt 60 ];    then REPLY="just now"
  elif [ "$s" -lt 3600 ];  then REPLY="$(( s / 60 ))m ago"
  elif [ "$s" -lt 86400 ]; then REPLY="$(( s / 3600 ))h ago"
  else                          REPLY="$(( s / 86400 ))d ago"
  fi
}

# _clock <epoch> - 14:10 for today, Sat 26 Sep 16:59 for any other day
_clock() {
  local day today
  printf -v day '%(%Y%m%d)T' "$1"
  printf -v today '%(%Y%m%d)T' "$NOW"
  if [ "$day" = "$today" ]; then printf -v REPLY '%(%H:%M)T' "$1"
  else printf -v REPLY '%(%a %d %b %H:%M)T' "$1"
  fi
}

# -------------------------------------------------------------- profiles ----
P_DIR=(); P_SHORT=(); P_KEY=(); P_DKEY=(); P_LABEL=(); P_COL=(); P_WHO=(); P_PLAN=()
P_KIND=()    # claude | codex
P_SRC=()     # "log" when the shown numbers came from a Codex session log
P_STATE=()   # pending | ok | stale | none
P_NOTE=()    # why a profile is not fresh, shown under its name
P_AT=()      # epoch the shown numbers were read, 0 for never
P_DATA=()    # "5h% 5h-reset 7d% 7d-reset opus% opus-reset sonnet% sonnet-reset", -1 = absent
P_ACCT=()    # the account P_DATA was read for, as a cksum of its id; "" for none
P_ID=()      # the account the dir is logged into now, the same way
P_RETRY=()   # epoch before which this account is not asked again, 0 for none

# cache_key <dir> - the cache file name for a dir with no account on record:
# readable, plus a checksum of the exact path. Flattening alone maps
# ~/.claude-a b and ~/.claude-a_b to one file, and then one profile shows the
# other's numbers. cksum is POSIX, so Linux and macOS name the file the same way.
cache_key() {
  local sum safe=${1//[^A-Za-z0-9._-]/_}
  sum=$(printf '%s' "$1" | cksum) || sum=0
  [ "${#safe}" -gt 100 ] && safe=${safe: -100}
  REPLY="${safe}-${sum%% *}"
}

# add_profile <dir> [claude|codex] - a Codex dir is labelled CODEX, CODEX-WORK
# and so on, so it never reads as a Claude profile of the same name
add_profile() {
  local dir=${1%/} kind=${2:-claude} i=${#P_DIR[@]} b
  b=${dir##*/}; b=${b#.}
  if [ "$kind" = codex ]; then
    [[ $b == codex* ]] || b="codex-$b"
  else
    b=${b#claude-}
    [ "$b" = claude ] && b=default
  fi
  cache_key "$dir"
  P_DIR+=("$dir"); P_KIND+=("$kind")
  P_SHORT+=("${dir/#"$HOME"/\~}")
  P_KEY+=("$REPLY"); P_DKEY+=("$REPLY")
  P_LABEL+=("${b^^}")
  # common profile names keep one colour everywhere; the rest take turns
  case ${b^^} in
    DEV)      P_COL+=("$C_G") ;;
    WORK)     P_COL+=("$C_Y") ;;
    PERSONAL) P_COL+=("$C_C") ;;
    CODEX)    P_COL+=("$C_BL") ;;
    *) local cyc=("$C_M" "$C_BL" "$C_G" "$C_Y" "$C_C"); P_COL+=("${cyc[i % 5]}") ;;
  esac
  P_WHO+=(""); P_PLAN+=(""); P_STATE+=(pending); P_NOTE+=(""); P_AT+=(0); P_DATA+=("")
  P_ACCT+=(""); P_ID+=(""); P_RETRY+=(0); P_SRC+=("")
}

# CLAUDE_USAGE_DIRS when set, else every ~/.claude-*/ that Claude Code has
# written its state into, else plain ~/.claude.
discover() {
  local d list=()
  if [ -n "${CLAUDE_USAGE_DIRS:-}" ]; then
    IFS=: read -ra list <<< "$CLAUDE_USAGE_DIRS"
    for d in ${list[@]+"${list[@]}"}; do
      [ -n "$d" ] && add_profile "${d/#\~/$HOME}"
    done
  else
    for d in "$HOME"/.claude-*/; do
      [ -d "$d" ] || continue
      [ -f "$d/.credentials.json" ] || [ -f "$d/.claude.json" ] || continue
      add_profile "$d"
    done
    [ "${#P_DIR[@]}" -gt 0 ] || { [ -d "$HOME/.claude" ] && add_profile "$HOME/.claude"; }
  fi
  discover_codex
  [ "${#P_DIR[@]}" -gt 0 ] ||
    die "no Claude Code or Codex profiles found (looked for ~/.claude-*/, ~/.claude and ~/.codex) - set CLAUDE_USAGE_DIRS"
}

# CLAUDE_USAGE_CODEX_DIRS when set, and set but empty means no Codex at all.
# Else ~/.codex, $CODEX_HOME and every ~/.codex-*/ that Codex has written a
# login or a session into, each once.
discover_codex() {
  local d list=() seen=":"
  if [ -n "${CLAUDE_USAGE_CODEX_DIRS+set}" ]; then
    IFS=: read -ra list <<< "$CLAUDE_USAGE_CODEX_DIRS"
    for d in ${list[@]+"${list[@]}"}; do
      [ -n "$d" ] && add_profile "${d/#\~/$HOME}" codex
    done
    return 0
  fi
  for d in "$HOME/.codex" "${CODEX_HOME:-}" "$HOME"/.codex-*/; do
    d=${d%/}
    [ -d "$d" ] || continue
    [ -f "$d/auth.json" ] || [ -d "$d/sessions" ] || continue
    case $seen in *":$d:"*) continue ;; esac
    seen+="$d:"
    add_profile "$d" codex
  done
}

# ----------------------------------------------------------------- login ----
# The unit separator keeps empty fields in place, which a tab would not: read
# treats a run of tabs as one.
JQ_LOGIN='.claudeAiOauth // {} | [.accessToken // "", (.expiresAt // 0 | floor | tostring),
  .subscriptionType // "", .rateLimitTier // ""] | join("\u001f")'
JQ_ACCOUNT='.oauthAccount // {} | [.emailAddress // "", .accountUuid // "", .organizationUuid // ""] | join("\u001f")'

# macOS keeps the login in the Keychain, named for how Claude Code was started
# rather than for the dir: "Claude Code-credentials" with CLAUDE_CONFIG_DIR
# unset, which can only mean ~/.claude, else that plus -<first 8 hex of
# sha256(CLAUDE_CONFIG_DIR)>. ~/.claude may have been opened either way, so it
# tries both; any other dir only ever has the second.
keychain_login() {
  local dir=$1 h svc svcs=()
  command -v security > /dev/null || return 1
  h=$(printf '%s' "$dir" | shasum -a 256) || return 1
  [ "$dir" = "$HOME/.claude" ] && svcs+=("Claude Code-credentials")
  svcs+=("Claude Code-credentials-${h:0:8}")
  for svc in "${svcs[@]}"; do
    security find-generic-password -a "$USER" -s "$svc" -w 2> /dev/null && return 0
  done
  return 1
}

# A Codex login is auth.json: the access token and the workspace it is for,
# beside an id_token whose claims carry the email, user and plan. The access
# token's own exp claim is when it stops working. Decoding a claim only reads
# it; nothing here can renew or rewrite the login.
# shellcheck disable=SC2016  # a jq program: $t, $id and $a are jq's own
JQ_CODEX_LOGIN='
def claims: try (split(".")[1] | gsub("-"; "+") | gsub("_"; "/")
  | . + ("=" * ((4 - length % 4) % 4)) | @base64d | fromjson) catch {};
(.tokens // {}) as $t
| (($t.id_token // "") | claims) as $id
| ($id["https://api.openai.com/auth"] // {}) as $a
| [$t.access_token // "",
   (($t.access_token // "") | claims | .exp // -1 | if type == "number" then floor else -1 end),
   $t.account_id // $a.chatgpt_account_id // "",
   $id.email // "", $a.chatgpt_user_id // $a.user_id // "", $a.chatgpt_plan_type // "",
   (if .OPENAI_API_KEY then 1 else "" end)]
| map(tostring) | join("\u001f")'

# login_claude <i> / login_codex <i> - set TOKEN, TOKEN_EXP (epoch ms, -1 for
# not known) and L_WHO, L_UUID, L_ORG, L_PLAN for load_login
login_claude() {
  local dir=${P_DIR[$1]} sub="" tier=""
  if [ -f "$dir/.credentials.json" ]; then
    IFS=$'\x1f' read -r TOKEN TOKEN_EXP sub tier < <(jq -r "$JQ_LOGIN" "$dir/.credentials.json" 2> /dev/null)
  elif [ "$PLATFORM" = darwin ]; then
    IFS=$'\x1f' read -r TOKEN TOKEN_EXP sub tier < <(keychain_login "$dir" | jq -r "$JQ_LOGIN" 2> /dev/null)
  fi
  [[ $TOKEN_EXP =~ ^[0-9]+$ ]] || TOKEN_EXP=0
  if [ -f "$dir/.claude.json" ]; then
    IFS=$'\x1f' read -r L_WHO L_UUID L_ORG < <(jq -r "$JQ_ACCOUNT" "$dir/.claude.json" 2> /dev/null)
  fi
  L_PLAN=$sub
  [[ $tier =~ max_([0-9]+x) ]] && L_PLAN="$sub ${BASH_REMATCH[1]}"
  return 0
}

# A Codex login's limits belong to the user within the workspace, so the pair
# is its account, the way a Claude account sits in an organisation.
login_codex() {
  local dir=${P_DIR[$1]} exp="" apikey=""
  [ -f "$dir/auth.json" ] || return 0
  IFS=$'\x1f' read -r TOKEN exp ACCOUNT L_WHO L_UUID L_PLAN apikey < <(jq -r "$JQ_CODEX_LOGIN" "$dir/auth.json" 2> /dev/null)
  L_ORG=$ACCOUNT
  # no exp on record is not an expired login: the endpoint says if it is
  if [[ $exp =~ ^[0-9]+$ ]]; then TOKEN_EXP=$(( exp * 1000 )); else TOKEN_EXP=-1; fi
  if [ -z "$TOKEN" ] && [ -n "$apikey" ]; then
    NO_LOGIN="signed in with an API key: billed per token, so there are no plan limits"
  fi
  return 0
}

# load_login <i> - sets TOKEN, TOKEN_EXP (epoch ms, -1 when the login does not
# say) and ACCOUNT (a Codex login's workspace), fills in who and plan, and sets
# NO_LOGIN to why there is no token. TOKEN stays in this shell: it reaches jq
# and curl through pipes, never argv and never a file.
load_login() {
  local i=$1 id pre=acct
  TOKEN=""; TOKEN_EXP=0; ACCOUNT=""; L_WHO=""; L_UUID=""; L_ORG=""; L_PLAN=""
  NO_LOGIN="not logged in: no login found for ${P_SHORT[i]}"
  if [ "${P_KIND[i]}" = codex ]; then login_codex "$i"; pre=codex; else login_claude "$i"; fi
  P_WHO[i]=${L_WHO%%@*}
  # Usage belongs to an account in an organisation: one email can hold a Pro
  # plan and a Team seat, each with its own limits and its own login. Readings
  # and rate-limit waits are filed under that pair, so dirs logged into the
  # same one share them, and a dir that switches finds the new one's. Ids that
  # are not plain uuids go through cksum rather than being flattened together.
  id=$(printf '%s' "${L_UUID:-$L_WHO}/$L_ORG" | cksum); P_ID[i]=${id%% *}
  if [ -z "$L_UUID" ]; then P_KEY[i]=${P_DKEY[i]}
  elif [[ "$L_UUID-$L_ORG" =~ ^[A-Za-z0-9-]+$ ]]; then P_KEY[i]="$pre-$L_UUID-$L_ORG"
  else P_KEY[i]="$pre-${P_ID[i]}"
  fi
  # A dir can be logged out and into another account. A reading kept from the
  # old one would then show under the new name, so it goes.
  if [ -n "${P_DATA[i]}" ] && [ "${P_ACCT[i]}" != "${P_ID[i]}" ]; then
    P_DATA[i]=""; P_AT[i]=0; P_ACCT[i]=""; P_STATE[i]=pending; P_RETRY[i]=0; P_SRC[i]=""
  fi
  P_PLAN[i]=$L_PLAN
  [ -n "$TOKEN" ]
}

# renew_hint <i> - how to renew a profile's login
renew_hint() {
  if [ "${P_KIND[$1]}" != codex ]; then REPLY="open Claude Code with ${P_SHORT[$1]} to renew it"
  elif [ "${P_DIR[$1]}" = "$HOME/.codex" ]; then REPLY="open Codex to renew it"
  else REPLY="open Codex with CODEX_HOME=${P_SHORT[$1]} to renew it"
  fi
}

# login_expired - the login load_login read has run out, or will within a
# minute. Sets REPLY to how long ago.
login_expired() {
  [ "$TOKEN_EXP" -ge 0 ] && [ $(( TOKEN_EXP / 1000 )) -le $(( NOW + 60 )) ] || return 1
  _ago $(( NOW - TOKEN_EXP / 1000 < 0 ? 0 : NOW - TOKEN_EXP / 1000 ))
}

# ----------------------------------------------------------------- cache ----
# Last good reading per profile, so an expired login or a dropped network still
# shows something. One line of numbers: when it was read, a cksum of the
# account it was read for, then the readings. Nothing from the login lands here.
# cache_read <i> - the profile's cached line into CA_AT, CA_ACCT, CA_DATA.
# A line from before readings carried their account fails here and is
# dropped rather than guessed at.
cache_read() {
  local f="$CACHE_DIR/${P_KEY[$1]}"
  CA_AT=""; CA_ACCT=""; CA_DATA=""
  [ -f "$f" ] && read -r CA_AT CA_ACCT CA_DATA < "$f" || return 1
  [[ $CA_AT =~ ^[0-9]+$ ]] && [[ $CA_ACCT =~ ^[0-9]+$ ]] && valid_data "$CA_DATA"
}

cache_load() {
  cache_read "$1" && [ "$CA_ACCT" = "${P_ID[$1]}" ] || return 0
  P_AT[$1]=$CA_AT; P_ACCT[$1]=$CA_ACCT; P_DATA[$1]=$CA_DATA; P_STATE[$1]=stale; P_SRC[$1]=""
}

# cache_fresh <i> - take this account's reading from the cache when it is
# younger than READ_GAP, whoever wrote it, instead of asking the endpoint.
# This is what keeps a live view and a once run, or two live views, from
# spending each other's one read a minute.
cache_fresh() {
  local i=$1
  cache_read "$i" && [ "$CA_ACCT" = "${P_ID[i]}" ] && [ $(( NOW - CA_AT )) -lt "$READ_GAP" ] || return 1
  P_AT[i]=$CA_AT; P_ACCT[i]=$CA_ACCT; P_DATA[i]=$CA_DATA; P_STATE[i]=ok; P_NOTE[i]=""; P_SRC[i]=""
}

cache_save() {
  local f="$CACHE_DIR/${P_KEY[$1]}"
  ( umask 077; mkdir -p "$CACHE_DIR" ) || return 0
  printf '%s %s %s\n' "${P_AT[$1]}" "${P_ACCT[$1]}" "${P_DATA[$1]}" > "$f.$$" && mv -f "$f.$$" "$f"
}

valid_data() { [[ $1 =~ ^-?[0-9]+( -?[0-9]+){7}$ ]]; }

# The wait after a 429 sits beside the cache, "<not before> <429s in a row>",
# so every claude-usage on the machine keeps to it. A success removes it.
backoff_load() {  # <i> - sets P_RETRY, and REPLY to the streak
  local f="$CACHE_DIR/${P_KEY[$1]}.retry" at n
  P_RETRY[$1]=0; REPLY=0
  [ -f "$f" ] && read -r at n < "$f" && [[ $at =~ ^[0-9]+$ ]] && [[ $n =~ ^[0-9]+$ ]] || return 0
  P_RETRY[$1]=$at; REPLY=$n
}

# backoff_save <i> <retry-after> - the endpoint has sent retry-after: 0 and
# then refused the retry, so its hint only counts when it asks for longer
backoff_save() {
  local i=$1 hint=$2 n k wait f="$CACHE_DIR/${P_KEY[$1]}.retry"
  backoff_load "$i"; n=$(( REPLY + 1 ))
  wait=$BACKOFF_FIRST
  for (( k = 1; k < n && wait < BACKOFF_MAX; k++ )); do wait=$(( wait * 2 )); done
  [ "$wait" -gt "$BACKOFF_MAX" ] && wait=$BACKOFF_MAX
  if [[ $hint =~ ^[0-9]+$ ]] && [ "$hint" -gt "$wait" ]; then
    wait=$(( hint > 3600 ? 3600 : hint ))
  fi
  P_RETRY[i]=$(( NOW + wait ))
  ( umask 077; mkdir -p "$CACHE_DIR" ) || return 0
  printf '%s %s\n' "${P_RETRY[i]}" "$n" > "$f.$$" && mv -f "$f.$$" "$f"
}

backoff_clear() { P_RETRY[$1]=0; rm -f "$CACHE_DIR/${P_KEY[$1]}.retry"; }

# ----------------------------------------------------------------- fetch ----
# resets_at carries microseconds and an offset, and fromdateiso8601 takes
# neither, so both are split off and put back by hand. The fraction matters:
# the API says 06:09:59.72 for a reset at 06:10, and truncating that shows a
# reset a minute early.
# shellcheck disable=SC2016  # a jq program: $m, $t and $s are jq's own
JQ_EPOCH='
def epoch:
  if type != "string" then -1
  else ([capture("^(?<d>[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2})(?<f>\\.[0-9]+)?(?<z>Z|[+-][0-9]{2}:?[0-9]{2})?$")] | first) as $m
    | if $m == null then -1
      else (try (($m.d + "Z" | fromdateiso8601) + ("0" + ($m.f // "") | tonumber)) catch null) as $t
        | if $t == null then -1
          elif ($m.z // "Z") == "Z" then $t
          else (if $m.z[0:1] == "-" then -1 else 1 end) as $s
            | $t - $s * (($m.z[1:3] | tonumber) * 3600 + ($m.z[-2:] | tonumber) * 60)
          end
      end
  end | . + 0.5 | floor;'
# shellcheck disable=SC2016  # a jq program: $k and $w are jq's own
JQ_USAGE="$JQ_EPOCH"'
def win($k): .[$k] as $w
  | if ($w | type) != "object" or ($w.utilization | type) != "number" then "-1 -1"
    else "\($w.utilization | floor) \($w.resets_at | epoch)" end;
[win("five_hour"), win("seven_day"), win("seven_day_opus"), win("seven_day_sonnet")] | join(" ")'

# Codex reports a primary and a secondary window, each with its length, from
# the endpoint in seconds and in a session log in minutes. The length decides
# the row, since a plan with only a weekly limit reports that one as primary:
# up to a day is the 5h row, longer the 7d row. A reset is an epoch, or failing
# that a count of seconds from $base, when the reading was taken.
# shellcheck disable=SC2016  # a jq program: $base, $w, $ws, $k, $s, $x are jq's own
JQ_CODEX="$JQ_EPOCH"'
def cwin($base):
  if type != "object" or (.used_percent | type) != "number" then null
  else {
    len: (.limit_window_seconds // (if (.window_minutes | type) == "number" then .window_minutes * 60 else null end) // -1),
    pct: (.used_percent | floor),
    at: (if (.reset_at | type) == "number" then .reset_at
         elif (.resets_at | type) == "number" then .resets_at
         elif (.reset_after_seconds | type) == "number" then $base + .reset_after_seconds
         elif (.resets_in_seconds | type) == "number" then $base + .resets_in_seconds
         else -1 end | floor)
  } end;
def limits($base):
  [(.primary | cwin($base)), (.secondary | cwin($base))] as $w
  | [range(0; 2) as $k | $w[$k] | select(. != null)
     | . + {slot: (if .len > 0 then (if .len <= 86400 then 0 else 1 end) else $k end)}] as $ws
  | [0, 1] | map(. as $s | ([$ws[] | select(.slot == $s)] | first) as $x
      | if $x == null then "-1 -1" else "\($x.pct) \($x.at)" end)
  | . + ["-1 -1", "-1 -1"] | join(" ");'
# The endpoint's answer. rate_limit is null for a plan with no limits.
# shellcheck disable=SC2016  # a jq program: $now is jq's own
JQ_CODEX_LIVE="$JQ_CODEX"'
if type == "object" and has("rate_limit")
then .rate_limit // {} | {primary: .primary_window, secondary: .secondary_window} | limits($now)
else error("not a usage answer") end'
# Every limits snapshot in a session log, as "<taken at> <readings>". Lines
# are parsed one at a time, so a line still being written is skipped rather
# than ending the rest; limits that are not Codex's own are left out.
# shellcheck disable=SC2016  # a jq program: $t is jq's own
JQ_CODEX_LOG="$JQ_CODEX"'
fromjson? | select(type == "object" and .payload.type? == "token_count")
| (.timestamp | epoch) as $t
| .payload.rate_limits | select(type == "object" and (.limit_id // "codex") == "codex" and $t > 0)
| "\($t) \(limits($t))"'

# request <file prefix> <kind> <token> [workspace] - one GET. The headers go in
# on stdin, so the token is never on a command line where ps could read it.
request() {
  local url=$API_URL args=(-H 'Accept: application/json')
  if [ "$2" = codex ]; then url=$CODEX_URL; else args+=(-H "anthropic-beta: $API_BETA"); fi
  {
    printf 'Authorization: Bearer %s\n' "$3"
    if [ "$2" = codex ]; then printf 'ChatGPT-Account-Id: %s\n' "${4:-}"; fi
  } | curl -sS --max-time 10 -D "$1.hdr" -o "$1.body" -w '%{http_code}' \
        -H @- "${args[@]}" -A "$PROG/$VERSION" "$url" > "$1.code" 2> "$1.err"
  printf '%s' "$?" > "$1.rc"
}

mark_stale() {
  P_NOTE[$1]=$2
  if [ -n "${P_DATA[$1]}" ]; then P_STATE[$1]=stale; else P_STATE[$1]=none; fi
}

collect() {
  local i=$1 f="$TMPD/$1" rc code data host=api.anthropic.com
  rc=$(< "$f.rc"); code=$(< "$f.code")
  [ "${P_KIND[i]}" = codex ] && host=chatgpt.com
  if [ "$rc" != 0 ]; then
    case $rc in
      6|7) mark_stale "$i" "offline: cannot reach $host" ;;
      28)  mark_stale "$i" "timed out asking for usage" ;;
      *)   mark_stale "$i" "request failed (curl exit $rc)" ;;
    esac
    return 0
  fi
  # chatgpt.com can turn a request away before it reaches the endpoint, with a
  # 403 page that is not JSON. That says nothing about the login.
  if [ "$code" = 403 ] && [ "${P_KIND[i]}" = codex ] && ! jq -e 'type == "object"' "$f.body" > /dev/null 2>&1; then
    mark_stale "$i" "chatgpt.com turned the request away (403)"
    return 0
  fi
  case $code in
    200) ;;
    401|403) renew_hint "$i"; mark_stale "$i" "login rejected ($code): $REPLY"; return 0 ;;
    429)
      HINT[i]=$(awk -F': *' 'tolower($1) == "retry-after" { sub(/\r$/, "", $2); print $2; exit }' "$f.hdr" 2> /dev/null)
      LIMITED+=("$i")
      return 0 ;;
    *)       mark_stale "$i" "usage endpoint answered $code"; return 0 ;;
  esac
  if [ "${P_KIND[i]}" = codex ]; then
    data=$(jq -r --argjson now "$NOW" "$JQ_CODEX_LIVE" "$f.body" 2> /dev/null) || data=""
  else
    data=$(jq -r "$JQ_USAGE" "$f.body" 2> /dev/null) || data=""
  fi
  if ! valid_data "$data"; then
    mark_stale "$i" "unexpected answer from the usage endpoint"
    return 0
  fi
  P_DATA[i]=$data; P_ACCT[i]=${P_ID[i]}; P_AT[i]=$NOW; P_STATE[i]=ok; P_NOTE[i]=""; P_SRC[i]=""
  cache_save "$i"
  backoff_clear "$i"
}

# mtime <file> - when it last changed, as an epoch, into REPLY. GNU stat
# first, then BSD's: the two spell it differently.
mtime() {
  REPLY=$(stat -c %Y "$1" 2> /dev/null || stat -f %m "$1" 2> /dev/null)
  [[ $REPLY =~ ^[0-9]+$ ]]
}

# codex_log <i> - the newest limits Codex itself was told, from its newest
# session log, into LOG_AT and LOG_DATA. Newest by change, not by name: a
# resumed session writes to the file it started in. A reading from before the
# login was saved may be another account's, so only one taken after it counts,
# and a log not written since is not opened. A token refresh rewrites the login
# too, which only holds back the readings before it until Codex's next turn.
codex_log() {
  local dir=${P_DIR[$1]} f best="" since=0
  LOG_AT=0; LOG_DATA=""
  for f in "$dir"/sessions/*/*/*/rollout-*.jsonl; do
    [ -f "$f" ] || continue
    if [ -z "$best" ] || [ "$f" -nt "$best" ]; then best=$f; fi
  done
  [ -n "$best" ] || return 1
  if [ -f "$dir/auth.json" ]; then
    [ "$best" -nt "$dir/auth.json" ] || return 1
    mtime "$dir/auth.json" && since=$REPLY
  fi
  read -r LOG_AT LOG_DATA < <(grep -F '"rate_limits"' "$best" | tail -n 200 |
    jq -rR "$JQ_CODEX_LOG" 2> /dev/null | tail -n 1)
  [[ $LOG_AT =~ ^[0-9]+$ ]] && [ "$LOG_AT" -gt "$since" ] && valid_data "$LOG_DATA"
}

# codex_fallback <i> - a Codex profile that could not be read shows what Codex
# was last told instead, when that is newer than the reading it has
codex_fallback() {
  local i=$1
  codex_log "$i" && [ "$LOG_AT" -gt "${P_AT[i]}" ] || return 0
  P_DATA[i]=$LOG_DATA; P_AT[i]=$LOG_AT; P_ACCT[i]=${P_ID[i]}; P_STATE[i]=stale; P_SRC[i]=log
}

# Two claude-usage here can ask for one account in the same moment: one gets
# the reading, the other a 429 for colliding with it. So before a 429 starts a
# wait, a reading from the other gets up to 2s to land, and is taken if it does.
LIMITED=(); HINT=()
settle() {
  local i k left=()
  for (( k = 0; k < 10 && ${#LIMITED[@]} > 0; k++ )); do
    [ "$k" -gt 0 ] && sleep 0.2
    left=()
    for i in "${LIMITED[@]}"; do cache_fresh "$i" || left+=("$i"); done
    LIMITED=(${left[@]+"${left[@]}"})
  done
  for i in ${LIMITED[@]+"${LIMITED[@]}"}; do
    backoff_save "$i" "${HINT[i]:-}"
    mark_stale "$i" "rate limited"
  done
  LIMITED=()
}

# launch <i> - ask for profile i with the login load_login just read.
# ASKED counts the requests actually sent, so r can say when it sent none.
ASKED=0; PIDS=(); LAUNCHED=()
launch() {
  ASKED=$(( ASKED + 1 ))
  request "$TMPD/$1" "${P_KIND[$1]}" "$TOKEN" "$ACCOUNT" &
  PIDS+=("$!"); LAUNCHED+=("$1")
}

# reap - wait for every launched request and take its answer. A trapped
# signal (a resize) cuts wait short, and collecting then would read
# half-written files, so each request is waited on until it has finished.
reap() {
  local i p
  TOKEN=""
  for p in ${PIDS[@]+"${PIDS[@]}"}; do
    while kill -0 "$p" 2> /dev/null; do wait "$p"; done
  done
  for i in ${LAUNCHED[@]+"${LAUNCHED[@]}"}; do
    [ -f "$TMPD/$i.rc" ] && collect "$i"
  done
  PIDS=(); LAUNCHED=()
  settle
}

# every profile at once: one slow account should not hold up the others
fetch_all() {
  local i j k n=${#P_DIR[@]} ago follow=()
  local -A asking=() own=()
  tick
  ASKED=0
  rm -f "$TMPD"/*
  for (( i = 0; i < n; i++ )); do
    if ! load_login "$i"; then
      mark_stale "$i" "$NO_LOGIN"
      continue
    fi
    if login_expired; then
      ago=$REPLY; renew_hint "$i"
      mark_stale "$i" "login expired $ago: $REPLY"
      continue
    fi
    cache_fresh "$i" && continue
    backoff_load "$i"
    if [ "${P_RETRY[i]}" -gt "$NOW" ]; then
      mark_stale "$i" "rate limited"
      continue
    fi
    # a dir on an account already being asked this round takes that answer
    # rather than spending the account's read a second time
    if [ -n "${asking[${P_KEY[i]}]:-}" ]; then follow+=("$i"); continue; fi
    asking[${P_KEY[i]}]=$i
    launch "$i"
  done
  reap
  # A follower takes its leader's answer: a 429, an outage or an odd reply
  # belongs to the account. A rejected login belongs only to the leader dir's
  # own token, so then one follower per account asks with its own login.
  for i in ${follow[@]+"${follow[@]}"}; do
    k=${P_KEY[i]}
    case ${P_NOTE[${asking[$k]}]} in
      "login rejected"*)
        if [ -z "${own[$k]:-}" ] && ! cache_fresh "$i" && load_login "$i"; then
          own[$k]=$i; launch "$i"
        fi ;;
    esac
  done
  reap
  for i in ${follow[@]+"${follow[@]}"}; do
    k=${P_KEY[i]}
    [ "${own[$k]:-}" = "$i" ] && continue
    cache_fresh "$i" && continue
    j=${own[$k]:-${asking[$k]}}
    backoff_load "$i"
    mark_stale "$i" "${P_NOTE[j]}"
  done
  for (( i = 0; i < n; i++ )); do
    [ "${P_KIND[i]}" = codex ] && [ "${P_STATE[i]}" != ok ] && codex_fallback "$i"
  done
  TOKEN=""; ACCOUNT=""
}

# ---------------------------------------------------------------- render ----
TCOLS=80; TROWS=24; BARW=24; WIDE=1; LBLW=2
OUT=()
STATUS=""; MSG=""

layout() {
  # indent 3, label, gaps, percent 4; the reset column only when it fits.
  # The label column is only as wide as "7d sonnet" when a plan reports one.
  local i w=() fixed
  LBLW=2
  for (( i = 0; i < ${#P_DATA[@]}; i++ )); do
    [ -n "${P_DATA[i]}" ] || continue
    read -ra w <<< "${P_DATA[i]}"
    [ "${w[4]}" -ge 0 ] && [ "$LBLW" -lt 7 ] && LBLW=7
    [ "${w[6]}" -ge 0 ] && LBLW=9
  done
  fixed=$(( 11 + LBLW ))
  if [ "$TCOLS" -ge 68 ]; then WIDE=1; fixed=$(( fixed + 33 )); else WIDE=0; fixed=$(( fixed + 9 )); fi
  BARW=$(( TCOLS - fixed - 1 ))
  [ "$BARW" -gt 30 ] && BARW=30
  [ "$BARW" -lt 8 ] && BARW=8
}

_pct_col() {
  if   [ "$1" -ge 90 ]; then REPLY=$C_R
  elif [ "$1" -ge 70 ]; then REPLY=$C_Y
  else                       REPLY=$C_G
  fi
}

# _bar <percent> <width> <marker cell, -1 for none> - eighth-cell tips
_bar() {
  local p=$1 width=$2 mk=$3 cells full frac i out="" col want glyph last=none
  [ "$p" -lt 0 ] && p=0
  [ "$p" -gt 100 ] && p=100
  _pct_col "$p"; col=$REPLY
  cells=$(( p * width * 8 / 100 )); full=$(( cells / 8 )); frac=$(( cells % 8 ))
  for (( i = 0; i < width; i++ )); do
    if   [ "$i" -eq "$mk" ];   then want=$C_B;   glyph=$MARK
    elif [ "$i" -lt "$full" ]; then want=$col;   glyph=${BLK[7]}
    elif [ "$i" -eq "$full" ] && [ "$frac" -gt 0 ]; then want=$col; glyph=${BLK[frac - 1]}
    else                            want=$C_DIM; glyph=$BAR_EMPTY
    fi
    # a colour only where it changes: a bar is most of a frame's bytes
    [ "$want" != "$last" ] && { out+="${C_0}${want}"; last=$want; }
    out+=$glyph
  done
  REPLY="${out}${C_0}"
}

# window_row <label> <window seconds> <percent> <reset epoch>
window_row() {
  local lab=$1 span=$2 pct=$3 at=$4 mk=-1 tail pc left line
  [ "$pct" -ge 0 ] || return 0
  _pct_col "$pct"; pc=$REPLY
  if [ "$at" -gt 0 ] && [ "$at" -le "$NOW" ]; then
    # the window rolled over after this was read, so it restarted from zero
    _clock "$at"; tail="${C_DIM}reset at ${REPLY}${C_0}"
    pct=0; pc=$C_DIM
  elif [ "$at" -gt 0 ]; then
    left=$(( at - NOW ))
    if [ "$left" -lt "$span" ]; then
      mk=$(( (span - left) * BARW / span ))
      [ "$mk" -ge "$BARW" ] && mk=$(( BARW - 1 ))
    fi
    _left "$left"; tail="in $REPLY"
    if [ "$WIDE" = 1 ]; then
      _clock "$at"; printf -v tail '%sresets %-16s%s %s' "$C_DIM" "$REPLY" "$C_0" "$tail"
    fi
  else
    tail="${C_DIM}idle${C_0}"
  fi
  _bar "$pct" "$BARW" "$mk"
  printf -v line '   %-*s %s %s%4s%s  %s' "$LBLW" "$lab" "$REPLY" "$pc" "$pct%" "$C_0" "$tail"
  OUT+=("$line")
}

profile_block() {
  local i=$1 line note w=()
  line=" ${P_COL[i]}${C_B}${P_LABEL[i]}${C_0}"
  [ -n "${P_WHO[i]}" ] && line+="  ${P_WHO[i]}"
  [ -n "${P_PLAN[i]}" ] && line+="  ${C_DIM}${P_PLAN[i]}${C_0}"
  if [ "${P_AT[i]}" -gt 0 ]; then
    _clock "${P_AT[i]}"
    case ${P_STATE[i]} in
      ok) line+="  ${C_DIM}updated ${REPLY}${C_0}" ;;
      *)  local c=$REPLY; _ago $(( NOW - P_AT[i] )); line+="  ${C_Y}as of ${c} (${REPLY})${C_0}"
          [ "${P_SRC[i]}" = log ] && line+="${C_DIM} from Codex's session log${C_0}" ;;
    esac
  fi
  OUT+=("$line")
  note=${P_NOTE[i]}
  if [ "$note" = "rate limited" ]; then
    if [ "${P_RETRY[i]}" -gt "$NOW" ]; then _left $(( P_RETRY[i] - NOW )); note+=": next try in $REPLY"
    else note+=": trying again at the next refresh"
    fi
  fi
  if [ -n "$note" ]; then
    if [ "${P_STATE[i]}" = none ]; then OUT+=("   ${C_R}! ${note}${C_0}")
    else OUT+=("   ${C_Y}! ${note}${C_0}")
    fi
  fi
  if [ -z "${P_DATA[i]}" ]; then
    [ "${P_STATE[i]}" = pending ] && OUT+=("   ${C_DIM}reading...${C_0}")
    return 0
  fi
  read -ra w <<< "${P_DATA[i]}"
  if [ "${w[0]}" -lt 0 ] && [ "${w[2]}" -lt 0 ] && [ "${w[4]}" -lt 0 ] && [ "${w[6]}" -lt 0 ]; then
    OUT+=("   ${C_DIM}no usage limits reported for this plan${C_0}")
    return 0
  fi
  window_row "5h"        "$SPAN_5H" "${w[0]}" "${w[1]}"
  window_row "7d"        "$SPAN_7D" "${w[2]}" "${w[3]}"
  window_row "7d opus"   "$SPAN_7D" "${w[4]}" "${w[5]}"
  window_row "7d sonnet" "$SPAN_7D" "${w[6]}" "${w[7]}"
}

render() {
  local i stamp
  OUT=()
  layout
  printf -v stamp '%(%a %d %b %H:%M:%S)T' "$NOW"
  OUT+=(" ${C_B}CLAUDE USAGE${C_0}  ${C_DIM}${stamp}${C_0}${STATUS:+  $STATUS}")
  for (( i = 0; i < ${#P_DIR[@]}; i++ )); do
    OUT+=("")
    profile_block "$i"
  done
  OUT+=("")
  OUT+=(" ${C_DIM}${MARK} time gone in each window: usage past it is ahead of pace${C_0}")
  if [ "${1:-}" = live ]; then
    OUT+=(" ${C_C}r${C_0} ${C_DIM}refresh${C_0}  ${C_C}q${C_0} ${C_DIM}quit${C_0}${MSG:+  $MSG}")
  fi
}

# ------------------------------------------------------------------ live ----
STTY_SAVED=""

term_size() {
  local sz
  sz=$(stty size <&3 2> /dev/null) || sz="24 80"
  TROWS=${sz%% *}; TCOLS=${sz##* }
  case "$TROWS$TCOLS" in *[!0-9]*|"") TROWS=24; TCOLS=80 ;; esac
  [ "$TROWS" -ge 8 ] || TROWS=24
  [ "$TCOLS" -ge 40 ] || TCOLS=80
}

# repaint in place with autowrap off: no clear, so nothing flickers, and a
# line wider than the terminal is clipped rather than wrapped into the next
paint() {
  local out=$'\033[H' i n=${#OUT[@]}
  for (( i = 0; i < n && i < TROWS; i++ )); do
    out+=$'\033['$(( i + 1 ))$';1H\033[K'"${OUT[i]}"
  done
  out+=$'\033['$(( i + 1 ))$';1H\033[J'
  printf '%s' "$out"
}

live_cleanup() {
  printf '\033[?7h\033[?1049l\033[?25h\033[0m'
  [ -n "$STTY_SAVED" ] && stty "$STTY_SAVED" <&3 2> /dev/null
  STTY_SAVED=""
}

watch_cmd() {
  local interval=${1:-$DEF_INTERVAL} next=0 key manual=0 due=0
  case $interval in ''|*[!0-9]*) die "refresh interval must be a whole number of seconds" ;; esac
  [ "$interval" -ge "$MIN_INTERVAL" ] ||
    die "refresh interval must be at least ${MIN_INTERVAL}s - the usage endpoint rate-limits"

  # piped, redirected, or with no terminal to read keys from: one snapshot
  if [ ! -t 1 ] || ! { exec 3< /dev/tty; } 2> /dev/null; then once_cmd; return; fi

  STTY_SAVED=$(stty -g <&3 2> /dev/null) || STTY_SAVED=""
  stty -echo -icanon <&3 2> /dev/null
  trap 'live_cleanup; exit 0' INT TERM
  trap 'live_cleanup; cleanup' EXIT
  trap 'term_size' WINCH
  printf '\033[?1049h\033[?25l\033[?7l'
  term_size

  while true; do
    tick
    if [ "$NOW" -ge "$next" ]; then
      STATUS="${C_C}reading...${C_0}"
      render live; paint
      fetch_all
      next=$(( NOW + interval ))
      # an r that asked nothing keeps the refresh that was already due
      if [ "$manual" = 1 ] && [ "$ASKED" = 0 ]; then
        MSG="${C_Y}nothing to ask yet: each account is read at most once a minute${C_0}"
        next=$due
      fi
      manual=0
    fi
    STATUS="${C_DIM}next in $(( next - NOW ))s${C_0}"
    render live; paint
    MSG=""
    key=""
    read -rn1 -t 1 key <&3
    case $key in
      q|Q) break ;;
      r|R) [ "$manual" = 1 ] || due=$next; next=0; manual=1 ;;
    esac
  done
}

# ------------------------------------------------------------- commands ----
once_cmd() {
  if [ -t 1 ]; then
    local c; c=$(tput cols 2> /dev/null) && [[ $c =~ ^[0-9]+$ ]] && TCOLS=$c
  fi
  fetch_all
  STATUS=""
  render
  printf '%s\n' "${OUT[@]}"
}

profiles_cmd() {
  local i state
  tick
  printf ' %s%-10s %-28s %s%s\n' "$C_DIM" PROFILE DIR LOGIN "$C_0"
  for (( i = 0; i < ${#P_DIR[@]}; i++ )); do
    if ! load_login "$i"; then
      case $NO_LOGIN in *"API key"*) state="${C_DIM}api key${C_0}" ;; *) state="${C_R}none${C_0}" ;; esac
    elif [ "$TOKEN_EXP" -lt 0 ]; then state="${C_G}valid${C_0}"
    elif [ $(( TOKEN_EXP / 1000 )) -le "$NOW" ]; then
      _ago $(( NOW - TOKEN_EXP / 1000 )); state="${C_Y}expired ${REPLY}${C_0}"
    else
      _clock $(( TOKEN_EXP / 1000 )); state="${C_G}valid until ${REPLY}${C_0}"
    fi
    TOKEN=""; ACCOUNT=""
    printf ' %s%-10s%s %-28s %s  %s%s%s\n' "${P_COL[i]}" "${P_LABEL[i]}" "$C_0" \
      "${P_SHORT[i]}" "$state" "$C_DIM" "${P_WHO[i]}${P_PLAN[i]:+ ${P_PLAN[i]}}" "$C_0"
  done
}

usage() {
  cat << EOF
${C_B}$PROG${C_0} $VERSION - Claude Code and Codex usage limits for every profile, on one screen

${C_B}USAGE${C_0}
  $PROG               live view in a terminal, one snapshot when piped
  $PROG watch [secs]  live view, refreshing every secs (default $DEF_INTERVAL, at least $MIN_INTERVAL)
  $PROG once          print one snapshot and exit
  $PROG profiles      the profiles found and whether their logins are valid
  $PROG version | help

${C_B}KEYS${C_0} ${C_DIM}(live view)${C_0}
  ${C_C}r${C_0} refresh now   ${C_C}q${C_0} quit

${C_B}PROFILES${C_0}
  Every ~/.claude-*/ directory Claude Code has used, or ~/.claude when
  there are none. CLAUDE_USAGE_DIRS picks them yourself:
    CLAUDE_USAGE_DIRS=~/.claude-work:~/.claude-personal $PROG
  Codex profiles are ~/.codex, \$CODEX_HOME and every ~/.codex-*/ Codex has
  used. CLAUDE_USAGE_CODEX_DIRS picks them, and set empty leaves Codex out.

${C_B}READING IT${C_0}
  5h and 7d are the rolling limits /usage shows, for the whole account: use
  on another machine or on claude.ai counts too. The ${MARK} in a bar is how far
  into that window you are, so a bar filled past it is on course to run out
  before the window resets.

${C_B}RATE LIMITS${C_0}
  The endpoint allows about one read a minute per account. A reading under
  a minute old, from any $PROG on this machine or any profile on the
  same account, is reused rather than asked for again, r included. After a
  429 that account waits 2 minutes, then 4, then 5, and every $PROG
  here keeps to the same wait.

${C_B}LOGINS${C_0}
  A login is read, never refreshed: refreshing rotates the token and can sign
  out a Claude or Codex session using that profile. When a login expires the
  profile shows its last reading until it is next opened. A Codex profile
  also shows what Codex itself was last told, from its session logs, when
  that is newer.

${C_B}ENVIRONMENT${C_0}
  CLAUDE_USAGE_DIRS        colon-separated config dirs to watch
  CLAUDE_USAGE_CODEX_DIRS  colon-separated Codex homes to watch, empty for none
  CODEX_HOME               a Codex home to watch besides ~/.codex and ~/.codex-*
  CLAUDE_USAGE_ASCII       1 draws with # and . instead of block glyphs
  NO_COLOR                 1 turns colour off
  XDG_CACHE_HOME           last readings are kept in \$XDG_CACHE_HOME/claude-usage
EOF
}

# ------------------------------------------------------------------ main ----
TMPD=""
cleanup() { [ -n "$TMPD" ] && rm -rf "$TMPD"; TMPD=""; }

cmd=${1:-}
[ $# -gt 0 ] && shift

case $cmd in
  help|-h|--help)       usage; exit 0 ;;
  version|-V|--version) echo "$PROG $VERSION"; exit 0 ;;
  ""|watch|w|once|o|profiles|ls) ;;
  *) die "unknown command '$cmd' - try: $PROG help" ;;
esac

need
discover

if [ "$cmd" = profiles ] || [ "$cmd" = ls ]; then profiles_cmd; exit 0; fi

TMPD=$(mktemp -d "${TMPDIR:-/tmp}/claude-usage.XXXXXX") || die "cannot create a temp dir"
trap cleanup EXIT
for (( _i = 0; _i < ${#P_DIR[@]}; _i++ )); do
  load_login "$_i" || true
  cache_load "$_i"
done
TOKEN=""

case $cmd in
  once|o) once_cmd ;;
  watch|w) watch_cmd "${1:-$DEF_INTERVAL}" ;;
  "") if [ -t 1 ]; then watch_cmd "$DEF_INTERVAL"; else once_cmd; fi ;;
esac
